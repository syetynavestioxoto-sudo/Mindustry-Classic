# Local iteration image: JDK8 + clang + Apple cctools + fake Xcode.
# (CI reproduces the same steps on ubuntu-22.04 runners; see ios-arm32.yml.)
FROM localhost/ld64-armv7:latest
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq openjdk-8-jdk unzip zip git libplist3 libssl3 \
 && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64 \
    FAKEXCODE=/opt/fakexcode \
    DEVELOPER_DIR=/opt/fakexcode
COPY tools/ios-fake-xcode /opt/fakexcode
ENV PATH="/opt/fakexcode/bin:${PATH}"
WORKDIR /src
CMD ["bash"]
